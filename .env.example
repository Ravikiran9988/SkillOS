# ──────────────────────────────────────────────────────────────────────────────
# SkillOS Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit a .env file with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ─── CognoDB / Neo4j Connection ────────────────────────────────────────────────
NEO4J_URI=bolt+s://db-xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
# Legacy aliases (backward compat)
COGNODB_URI=bolt+s://db-xxxxxxxx.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_password_here

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ─
JWT_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email Provider (Zoho SMTP / Console) ──────────────────────────────────────
# Supported: smtp | console | resend | sendgrid
EMAIL_PROVIDER=smtp
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=admin@kiranverse.tech
SMTP_PASSWORD=your_zoho_app_password
SMTP_FROM="KiranVerse <admin@kiranverse.tech>"

# ─── Application ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@skillos.app

# ─── AI / LLM Provider (Groq) ──────────────────────────────────────────────────
# CognoDB is the authoritative knowledge graph. Groq provides the reasoning layer.
# Never expose GROQ_API_KEY to the frontend.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Client (used by Vite) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
